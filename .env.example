# ضع هذه القيم في Vercel (Settings > Environment Variables) وفي ملف .env.local عند التشغيل المحلي
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===== الإشعارات (اختيارية، راجع docs/INTEGRATION.md) =====
# البريد عبر Resend
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_TO_EMAIL=
# واتساب عبر WhatsApp Cloud API من Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
# اختياري: اسم قالب معتمد في Meta لإرسال الإشعار خارج نافذة 24 ساعة
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
