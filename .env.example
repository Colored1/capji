# ضع هذه القيم في Vercel (Settings > Environment Variables) وفي ملف .env.local عند التشغيل المحلي
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===== الإشعارات (اختيارية، راجع docs/INTEGRATION.md) =====
# البريد عبر Resend
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_TO_EMAIL=
# واتساب عبر WhatsApp Cloud API من Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
# اختياري: اسم قالب معتمد في Meta لإرسال الإشعار خارج نافذة 24 ساعة
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar

# ===== البث المباشر والمزامنة التلقائية (راجع docs/INTEGRATION.md) =====
# مفتاح الخادم (سري جداً، لا يُنشر للمتصفح): Supabase > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=
# مفتاح مجاني من football-data.org لجلب جدول المباريات
FOOTBALL_DATA_API_KEY=
# اختياري: رموز الدوريات مفصولة بفاصلة مثل PL,PD,CL (فارغ = كل ما تتيحه الخطة المجانية)
FOOTBALL_DATA_COMPETITIONS=
# سر يحمي رابط المزامنة من الاستخدام الخارجي (اكتب أي نص عشوائي طويل)
CRON_SECRET=
